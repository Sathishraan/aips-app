{
    "info": {
        "name": "AIPS Student API",
        "description": "Aadhithya International Public Schools - Student Data API Collection",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Student Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "",
                                    "if (jsonData.status === \"success\" && jsonData.data.token) {",
                                    "    pm.environment.set(\"token\", jsonData.data.token);",
                                    "    console.log(\"Token saved:\", jsonData.data.token);",
                                    "    ",
                                    "    if (jsonData.data.user && jsonData.data.user.stud_id) {",
                                    "        pm.environment.set(\"student_id\", jsonData.data.user.stud_id);",
                                    "        console.log(\"Student ID saved:\", jsonData.data.user.stud_id);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "username",
                                    "value": "student123",
                                    "type": "text"
                                },
                                {
                                    "key": "password",
                                    "value": "password123",
                                    "type": "text"
                                },
                                {
                                    "key": "academic_year",
                                    "value": "2024-2025",
                                    "type": "text"
                                },
                                {
                                    "key": "device_type",
                                    "value": "1",
                                    "type": "text",
                                    "description": "1 for Android, 2 for iOS"
                                },
                                {
                                    "key": "firebase_token",
                                    "value": "",
                                    "type": "text",
                                    "disabled": true
                                },
                                {
                                    "key": "device",
                                    "value": "",
                                    "type": "text",
                                    "disabled": true
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}api/login",
                            "host": [
                                "{{base_url}}api"
                            ],
                            "path": [
                                "login"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
